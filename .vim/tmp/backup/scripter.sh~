# Verzeichnis in dem sich das Script befindet
shlearning="/home/pierelucas/Projekte/Learning/Shell/scripter:"
dir="$shlearning"

# Editor, der verwendet werden soll
editor="vi"

# erstes Argument muss der Scriptname sein ...
[ -z "$1" ] && exit 1

# Editor muss starten und Scripte laden (oder erzeugen)
